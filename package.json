{
    "name": "project-deployment",
    "description": "Serverless API for project deployment automation",
    "version": "0.0.1",
    "private": true,
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.398.0",
        "@aws-sdk/client-s3": "^3.744.0",
        "@aws-sdk/lib-dynamodb": "^3.398.0",
        "@jigjoy-io/file-artifacts": "^0.0.5",
        "@jigjoy-io/project-versioning-client": "^0.0.8",
        "@jigjoy-io/serverless-core": "^0.0.3",
        "ajv": "^8.16.0",
        "ajv-formats": "^3.0.1",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.140",
        "@types/node": "^20.14.9",
        "@types/uuid": "^10.0.0",
        "esbuild": "^0.25.9",
        "npm-run-all": "^4.1.5",
        "swagger-ui-watcher": "^2.1.14",
        "ts-node": "^10.9.2",
        "typescript": "^5.5.2"
    },
    "scripts": {
        "build": "sam build --profile Development",
        "deploy": "sam deploy --profile Development --capabilities CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND",
        "serve": "sam local start-api --profile Development --host 0.0.0.0 --port 7000 --region eu-west-1 --env-vars env.json",
        "docs": "npx swagger-ui-watcher openapi.yaml --port 7070",
        "dev": "npm-run-all --parallel serve docs",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "format": "prettier --write \"{src,packages}/**/*.{ts,tsx}\""
    },
    "jest": {
        "testMatch": [
            "**/__tests__/**/*.[jt]s?(x)",
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/__tests__/**/*.mjs?(x)",
            "**/?(*.)+(spec|test).mjs?(x)"
        ],
        "moduleFileExtensions": [
            "mjs",
            "js"
        ]
    }
}
